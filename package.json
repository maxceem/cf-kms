{
  "name": "@maxceem/cf-kms",
  "version": "0.1.0",
  "private": false,
  "description": "A tiny KMS-shaped Cloudflare Worker that wraps and unwraps data encryption keys, plus a zero-dependency envelope-encryption client.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "author": "Maksym Mykhailenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxceem/cf-kms.git"
  },
  "homepage": "https://github.com/maxceem/cf-kms#readme",
  "bugs": {
    "url": "https://github.com/maxceem/cf-kms/issues"
  },
  "keywords": [
    "aes-gcm",
    "cloudflare-workers",
    "encryption-context",
    "envelope-encryption",
    "hono",
    "kms",
    "key-management",
    "webcrypto"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src/client",
    "README.md"
  ],
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cf-typegen": "node scripts/wrangler.mjs types",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "deploy": "node scripts/wrangler.mjs deploy",
    "deploy:dry-run": "node scripts/wrangler.mjs deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/node": "26.2.0",
    "hono": "^4.12.8",
    "jsonc-parser": "^3.3.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.125.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.24.0"
}
